<canvas id='game_canvas'></canvas>

<div id='home_background'>
    <img id="home_background_image" src="/assets/images/background/space.jpg" alt="">
</div>

<div id='welcome_container'>
    <div id='home_error_message'></div>
    <div id='connecting_message'><%= t('Connecting') %> <div class="lds-ring"><div></div><div></div><div></div><div></div></div></div>

    <div class='middle_container'>
        <section id='local_world_menu' aria-label='Local worlds'>
            <div class='home_shade'></div>

            <div class='home_topbar'>
                <label class='local_profile'>Playing as <input class='local_player_name' maxlength='16' autocomplete='nickname' aria-label='Your name'></label>
                <div id='language_selector'>
                    <img src="/assets/images/language_icon.png" class='language_icon' alt='Language' />
                    <select id='language_select' aria-label='Language'>
                        <option value='en'>English</option>
                        <option value='ru'>Русский</option>
                        <option value='ja'>日本語</option>
                    </select>
                </div>
            </div>

            <div class='home_rail'>
                <div class='home_brand'>
                    <h1 id='game_caption'>JUNON . IO</h1>
                    <div class='home_tagline'>Space Colony Survival &middot; Co-op</div>
                </div>

                <nav class='local_menu_actions'>
                    <button class='local_continue_btn home_nav_item'>
                        <span>Continue</span>
                        <span class='local_continue_detail'></span>
                    </button>
                    <button class='local_new_btn home_nav_item' data-panel='new'>New world</button>
                    <button class='local_load_btn home_nav_item' data-panel='load'>Load world</button>
                    <button class='local_tutorial_btn home_nav_item' data-panel='tutorial'>Tutorial</button>
                    <button class='local_host_btn home_nav_item' data-panel='host'>Host co-op</button>
                    <button class='local_join_btn home_nav_item' data-panel='join'>Join co-op</button>
                    <button class='local_import_btn home_nav_item' data-panel='import'>Import save</button>
                </nav>

                <button class='local_menu_version local_changelog_btn' title='Patch notes'>Version <span class='game_version'><%= gameVersion %></span></button>
            </div>

            <%# the latest releases, newest first, for the Patch notes panel %>
            <template id='local_changelog_template'>
                <h2>Patch notes</h2>
                <% const changeLogSectionLabels = { features: 'New', bugs: 'Fixes' } %>
                <% changeLogs.slice(0, 10).forEach((changeLog) => { %>
                    <article class='local_changelog_entry'>
                        <div class='local_changelog_heading'><span class='local_changelog_version'><%= changeLog.version %></span><span class='local_changelog_date'><%= changeLog.date %></span></div>
                        <% if (changeLog.title) { %><div class='local_changelog_title'><%= changeLog.title %></div><% } %>
                        <% Object.keys(changeLog.content).forEach((section) => { %>
                            <% if (changeLog.content[section].length > 0) { %>
                                <div class='local_changelog_section'><%= changeLogSectionLabels[section] || section %></div>
                                <ul>
                                    <% changeLog.content[section].forEach((item) => { %><li><%= item %></li><% }) %>
                                </ul>
                            <% } %>
                        <% }) %>
                    </article>
                <% }) %>
            </template>

            <div class='home_content'>
                <p class='local_menu_message' role='status'></p>
                <div class='local_menu_panel'></div>
            </div>
        </section>
    </div>
    
    <div id='background'></div>

    <div class='main_menu'>
        <div class='resume_menu_btn main_menu_btn'><%= t('Resume') %></div>
        <div class='settings_menu_btn main_menu_btn'><%= t('Settings') %></div>
        <div class='exit_game_menu_btn main_menu_btn'><%= t('Exit Game') %></div>
    </div>

    <div class='main_menu_navigator'>
        <div class='back_main_menu_btn'>
            <img src="/assets/images/arrow_back_icon.png" />
            <%= t('Back') %>
        </div>

        <div class='settings_container'>
            <div class='sounds_container'>
                <div class='menu_main_header'><%= t('Sound') %></div>
                <div>
                    <%= t('Background Volume') %>
                    <div class='volume_slider_container'>
                        <input type="range" min="0" max="10" value="5" class="background_volume_slider">
                        <span class='background_volume_value volume_value'></span>
                    </div>
                </div>
                <div>
                    <%= t('Effects Volume') %>
