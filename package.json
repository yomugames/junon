{
  "name": "junon",
  "scripts": {
    "server": "npm run inspect --workspace packages/junon-io",
    "client": "npm run client --workspace packages/junon-io",
    "desktop": "npm run start --workspace packages/junon-desktop",
    "test": "npm run test --workspace packages/junon-io",
    "client:build": "npm run client:build --workspace packages/junon-io"
  },
  "workspaces": [
    "packages/*"
  ],
  "nodemonConfig": {
    "ext": "js, json, proto"
  },
  "dependencies": {
    "perlin-noise": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
